# Copy to frontend/.env.local
#
# At least one of the two variables below MUST be set — the app will not connect to the
# backend without them.
#
# NEXT_PUBLIC_BACKEND_URL  — baked into the JS bundle at build time; used by the browser
#                            directly. Set this to the public URL of your backend service.
#
# BACKEND_URL              — read by the Next.js server at runtime; used as the target for
#                            the /backend/* rewrite proxy AND to inject window.__BACKEND_URL__.
#                            Set this to the backend's public (or internal Docker) URL.
#
# For local development both should point to your local backend.

NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.com
BACKEND_URL=https://your-backend-domain.com
