# =============================================================================
# Ottobiz backend — copy to app/.env and fill in values
# =============================================================================
#
# Minimal local dev (docker compose up in app/):
#   Required: MODEL_API_KEY
#   Auto-set by compose: DATABASE_URL, REDIS_URL
#   Defaults below work for postgres + redis services
#
# Frontend (separate): see ../frontend/.env.example
# =============================================================================

# --- Required ---
# Gemini / LLM API key (chat agents will not run without this)
MODEL_API_KEY=

# Postgres connection (compose builds this from POSTGRES_* when unset)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ottobiz

# Redis connection (compose builds this from REDIS_PASSWORD when unset)
REDIS_URL=redis://:redispassword@localhost:6379/0

# --- Docker Compose (postgres + redis services) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ottobiz
REDIS_PASSWORD=redispassword

# --- Core ---
DEBUG=False
MODEL_NAME=gemini-2.0-flash
# Optional stronger model for central coordinator; falls back to MODEL_NAME
CENTRAL_AGENT_MODEL_NAME=
# Public URL of this API (required for webhook callbacks and file download links)
BASE_URL=https://your-backend-domain.com
LOG_FILE=app.log

# --- Database (optional if DATABASE_URL is set) ---
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=

# --- Redis (used when DEBUG=true without REDIS_URL) ---
REDIS_SERVER_HOST=localhost
REDIS_SERVER_PORT=6379
REDIS_SERVER_PASSWORD=

# --- Supabase (optional; use DATABASE_URL for Postgres instead) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Paystack (optional; payments / webhooks) ---
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_DEFAULT_CURRENCY=NGN

# --- WhatsApp Cloud API (optional; Meta webhook + messaging) ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=
APP_SECRET=
# Legacy aliases (fallback to WHATSAPP_* when empty)
PAGE_ACCESS_TOKEN=
PHONE_NUMBER_ID=

# --- AWS S3 uploads (optional) ---
SAVE_UPLOADS_TO_S3=false
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Observability (optional) ---
LOGFIRE_TOKEN=

# --- Chat / session tuning (optional) ---
CHAT_HISTORY_SUMMARY_WORD_LIMIT=2048
CHAT_HISTORY_KEEP_LAST_N=20
COMM_HISTORY_SUMMARY_WORD_LIMIT=1024
COMM_HISTORY_KEEP_LAST_N=10
FILE_TEXT_CACHE_MAX=5
PRODUCTS_CACHE_TTL_HOURS=6
PAYSTACK_WEBHOOK_CONFIRMED_MAX=50
BANK_RECEIPT_MAX_AGE_HOURS=72
BANK_RECEIPT_AMOUNT_TOLERANCE=0.001

# --- Rate limiting (optional) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- AI integration tests (optional; pytest backend/tests/ai_tests) ---
AUTOBIZ_BASE_URL=http://127.0.0.1:8000
AI_TEST_TIMEOUT_S=120
AI_TEST_INBOX_POLL_S=2
AI_TEST_INBOX_MAX_WAIT_S=90
